@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix skosxl:  <http://www.w3.org/2008/05/skos-xl#> .
@prefix dct:     <http://purl.org/dc/terms/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix bdi:     <https://begrippen.bdinetwork.org/id/begrip/> .

<https://begrippen.bdinetwork.org/id/begrippenkader/bdi> a skos:ConceptScheme ;
    dct:title "BDI Begrippenkader"@nl , "BDI Glossary"@en ;
    dct:description "Begrippen uit de BDI Referentiearchitectuur, beschreven conform NL-SBB en geserialiseerd als SKOS."@nl ;
    dct:publisher "Basic Data Infrastructure" ;
    dct:modified "2026-07-21"^^xsd:date .


bdi:association a skos:Concept ;
    skos:inScheme <https://begrippen.bdinetwork.org/id/begrippenkader/bdi> ;
    skos:prefLabel "Association"@en ;
    skos:definition "Legal entity that serves as trust anchor for both federated trust/authentication and local onboarding."@en ;
    dct:source "file://tests/fixtures/bdi-terms.md" ;
    skos:relatedMatch <https://dssc.eu/glossary/data-space-governance-authority> .

bdi:association-administrator a skos:Concept ;
    skos:inScheme <https://begrippen.bdinetwork.org/id/begrippenkader/bdi> ;
    skos:prefLabel "Association Administrator"@en ;
    skos:altLabel "Association Authority"@en ;
    skos:definition "Functionary responsible for operating the services of a BDI Association reporting to its Members."@en ;
    dct:source "file://tests/fixtures/bdi-terms.md" .

bdi:association-register a skos:Concept ;
    skos:inScheme <https://begrippen.bdinetwork.org/id/begrippenkader/bdi> ;
    skos:prefLabel "Association Register"@en ;
    skos:altLabel "Branch Register"@en ;
    skos:definition "Register of onboarded Members, and Preferred Business Partners of a particular BDI Association instance."@en ;
    dct:source "file://tests/fixtures/bdi-terms.md" .

bdi:authorization-register-data-management a skos:Concept ;
    skos:inScheme <https://begrippen.bdinetwork.org/id/begrippenkader/bdi> ;
    skos:prefLabel "Authorization Register Data Management"@en ;
    skos:altLabel "AR-DM"@en ;
    skos:definition "Holds authorization policies for one or more Data Owners on access to data"@en ;
    dct:source "file://tests/fixtures/bdi-terms.md" .

bdi:bdi-authentication-processor a skos:Concept ;
    skos:inScheme <https://begrippen.bdinetwork.org/id/begrippenkader/bdi> ;
    skos:prefLabel "BDI Authentication Processor"@en ;
    skos:definition "Standard software to make APIs BDI compliant. Processing of part of protocol: client assertion to token."@en ;
    dct:source "file://tests/fixtures/bdi-terms.md" .

bdi:business-partners a skos:Concept ;
    skos:inScheme <https://begrippen.bdinetwork.org/id/begrippenkader/bdi> ;
    skos:prefLabel "Business Partners"@en ;
    skos:definition "Member of a different BDI Association than the root. Note: this a relative perspective, from the position of a Member of a given instance (BDI Association)."@en ;
    dct:source "file://tests/fixtures/bdi-terms.md" .

bdi:certified-roles a skos:Concept ;
    skos:inScheme <https://begrippen.bdinetwork.org/id/begrippenkader/bdi> ;
    skos:prefLabel "Certified Roles"@en ;
    skos:definition "Roles for which certification is required. Facilitate certain functions for BDI that every member within the Association must be able to rely upon."@en ;
    dct:source "file://tests/fixtures/bdi-terms.md" .

bdi:data-custodian a skos:Concept ;
    skos:inScheme <https://begrippen.bdinetwork.org/id/begrippenkader/bdi> ;
    skos:prefLabel "Data Custodian"@en ;
    skos:definition "Similar to DSSC's Data Provider. A data custodian regulates the data access and provides the data to recipients that should have access."@en ;
    dct:source "file://tests/fixtures/bdi-terms.md" ;
    skos:closeMatch <https://dssc.eu/glossary/data-provider> .

bdi:data-owner a skos:Concept ;
    skos:inScheme <https://begrippen.bdinetwork.org/id/begrippenkader/bdi> ;
    skos:prefLabel "Data Owner"@en ;
    skos:definition "The data Owner is a legal entity who has control over data and access to data, controls decisions on Data Sovereignty and Trust Sovereignty, controls authorization policies."@en ;
    dct:source "file://tests/fixtures/bdi-terms.md" .

bdi:data-sovereignty a skos:Concept ;
    skos:inScheme <https://begrippen.bdinetwork.org/id/begrippenkader/bdi> ;
    skos:prefLabel "Data Sovereignty"@en ;
    dct:source "file://tests/fixtures/bdi-terms.md" .

bdi:member a skos:Concept ;
    skos:inScheme <https://begrippen.bdinetwork.org/id/begrippenkader/bdi> ;
    skos:prefLabel "Member"@en ;
    skos:definition "Legal entity as member of a root BDI Association"@en ;
    dct:source "file://tests/fixtures/bdi-terms.md" .

bdi:operational-data-store a skos:Concept ;
    skos:inScheme <https://begrippen.bdinetwork.org/id/begrippenkader/bdi> ;
    skos:prefLabel "Operational Data Store"@en ;
    skos:definition "An Operational Data Store (ODS) is designed to integrate data from multiple sources for additional operations on the data."@en ;
    dct:source "file://tests/fixtures/bdi-terms.md" .

bdi:operations-and-supply-chain-data-spaces a skos:Concept ;
    skos:inScheme <https://begrippen.bdinetwork.org/id/begrippenkader/bdi> ;
    skos:prefLabel "Operations and Supply Chain Data Spaces"@en ;
    skos:definition "Operations and Supply Chain Data Spaces (ODS) are logical constructs, networks of parties, both businesses and authorities, created to generate value."@en ;
    dct:source "file://tests/fixtures/bdi-terms.md" .

bdi:outsider a skos:Concept ;
    skos:inScheme <https://begrippen.bdinetwork.org/id/begrippenkader/bdi> ;
    skos:prefLabel "Outsider"@en ;
    skos:definition "Anyone who is not a Member of a BDI Association."@en ;
    dct:source "file://tests/fixtures/bdi-terms.md" .

bdi:preferred-business-partners a skos:Concept ;
    skos:inScheme <https://begrippen.bdinetwork.org/id/begrippenkader/bdi> ;
    skos:prefLabel "Preferred Business Partners"@en ;
    skos:definition "Business Partners who have agreed to specific terms and conditions of the local BDI Association that maintains its own Business Partner Reputation Model"@en ;
    dct:source "file://tests/fixtures/bdi-terms.md" .

bdi:pulse a skos:Concept ;
    skos:inScheme <https://begrippen.bdinetwork.org/id/begrippenkader/bdi> ;
    skos:prefLabel "Pulse"@en ;
    skos:altLabel "Trigger"@en ;
    skos:definition "Datagram, distributed to Subscriber to a Topic. A signal from the data Owner that there is data ready for the consumer to come and access"@en ;
    dct:source "file://tests/fixtures/bdi-terms.md" .

bdi:root-association a skos:Concept ;
    skos:inScheme <https://begrippen.bdinetwork.org/id/begrippenkader/bdi> ;
    skos:prefLabel "Root Association"@en ;
    skos:definition "The association to which a BDI participant belongs."@en ;
    dct:source "file://tests/fixtures/bdi-terms.md" .

bdi:visitor a skos:Concept ;
    skos:inScheme <https://begrippen.bdinetwork.org/id/begrippenkader/bdi> ;
    skos:prefLabel "Visitor"@en ;
    skos:definition "Outsider with a better reputation score than a set minimum"@en ;
    dct:source "file://tests/fixtures/bdi-terms.md" .
